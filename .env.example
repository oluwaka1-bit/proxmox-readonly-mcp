# Read only when the server starts with --backend live. Not auto-loaded.
PVE_URL=https://proxmox.example.com:8006
PVE_NODE=example-node
PVE_GUEST_IDS=101,102
PVE_TOKEN_FILE=/absolute/path/to/private/proxmox.token
# Optional: omit when the system roots validate the server certificate.
# PVE_CA_FILE=/absolute/path/to/private/cluster-ca.pem
PVE_TIMEOUT=10
